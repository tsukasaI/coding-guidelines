# Copy to `lefthook.yml` at the project root, then run `lefthook install`.
# Per patterns/tooling.md: lefthook is the mandated pre-commit orchestrator;
# every job here is a zero-warnings gate (a warning fails the commit).
#
# The language-specific jobs below are glob-scoped and no-op harmlessly if
# that language isn't present in the project — keep only the ones you need.

pre-commit:
  parallel: true
  commands:
    gitleaks:
      run: gitleaks git --staged --redact

    go-format:
      # -w + stage_fixed auto-fix instead of failing: a deliberate exception
      # to the zero-warnings gate (patterns/tooling.md "Maximal strictness
      # stance"). gofumpt's rewrite is deterministic and semantics-free, so
      # auto-fixing loses nothing.
      glob: "*.go"
      run: gofumpt -l -w {staged_files}
      stage_fixed: true
    go-lint:
      glob: "*.go"
      run: golangci-lint run --config .golangci.yml {staged_files}
    go-layout-ban:
      # go.md "NEVER create a pkg/ directory" — depguard bans import paths,
      # not directory names, so this is a plain glob-triggered shell job.
      # Also catches a nested pkg/ (internal/pkg/, cmd/pkg/), not just root.
      glob: "{pkg,**/pkg}/**"
      run: >
        echo "layout-ban: pkg/ is not part of the official Go layout (see
        languages/go.md Project layout); use internal/ or a domain-named
        package" >&2 && exit 1

    rust-format:
      glob: "*.rs"
      run: cargo fmt -- --check
    rust-lint:
      glob: "*.rs"
      run: cargo clippy --all-targets -- -D warnings

    ts-format:
      # oxfmt covers .svelte too, given .oxfmtrc.json's `svelte: true`
      glob: "*.{ts,tsx,svelte}"
      run: npx oxfmt -c .oxfmtrc.json --check {staged_files}
    ts-lint:
      glob: "*.{ts,tsx}"
      # --type-aware is required for no-floating-promises and
      # switch-exhaustiveness-check (needs the oxlint-tsgolint devDependency)
      # --deny-warnings: a rule downgraded to "warn" must still fail the hook
      run: npx oxlint --type-aware --deny-warnings -c .oxlintrc.json {staged_files}
    ts-layout-ban:
      # typescript.md "group by domain feature, not by kind" — no linter
      # covers directory naming, so this is a plain glob-triggered shell job.
      # Also catches a nested src/ (monorepo packages/*/src/utils/, etc).
      glob: "{src,**/src}/{types,interfaces,utils}/**"
      run: >
        echo "layout-ban: group by domain feature (src/order/, src/billing/),
        not by kind (see languages/typescript.md Project layout)" >&2 && exit 1

# CI-only checks. Projects WITHOUT CI MUST run these from pre-push instead
# (patterns/tooling.md "Maximal strictness stance"); projects with CI can
# leave them commented out. Uncomment what applies.
#
# pre-push:
#   parallel: true
#   commands:
#     rust-deny:
#       glob: "{Cargo.toml,Cargo.lock,deny.toml}"
#       run: cargo deny check
#     rust-audit:
#       glob: "{Cargo.toml,Cargo.lock}"
#       run: cargo audit
#     # Generic codegen drift check (patterns/codegen.md): regenerate, then
#     # fail if the committed output differs. Replace `make generate` with the
#     # project's generator command (e.g. `sqlc generate`).
#     codegen-drift:
#       run: make generate && git diff --exit-code
#     # Spec lint (patterns/codegen.md), e.g. spectral:
#     # openapi-lint:
#     #   glob: "openapi/**"
#     #   run: npx spectral lint openapi/openapi.yaml

# Copy to `clippy.toml` at the project root.
# Scopes the unwrap_used/expect_used/indexing_slicing/dbg_macro/print_stdout/
# print_stderr denies in templates/cargo-lints.toml.example away from test
# code, per languages/rust.md: "Every `unwrap` outside tests needs to be `?`..."
#
# Observed on clippy 0.1.93 (rust-clippy#13981, still open): covered =
# in-crate #[cfg(test)] code and #[test] functions anywhere, including
# tests/. Not covered = non-test helper fns in tests/, and examples/ and
# benches/; those stay subject to the deny. Integration tests exercise the
# public API like any other caller (languages/rust.md "Testing"), so in
# helpers use `?`/`.get()` or #[expect(lint, reason = "...")]. rust-clippy
# PR #16786 ("Detect integration tests in `is_in_test`") may widen
# coverage; re-check on toolchain bumps.

allow-unwrap-in-tests = true
allow-expect-in-tests = true
allow-indexing-slicing-in-tests = true
allow-dbg-in-tests = true
allow-print-in-tests = true

# Per languages/rust.md "Implementation": no catch_unwind in first-party
# code (Google Rust Style Guide). disallowed_methods is in the style group,
# so this is a deny under cargo-lints.toml.example.
disallowed-methods = [
    { path = "std::panic::catch_unwind", reason = "panics are bugs; don't recover from them (languages/rust.md)" },
]

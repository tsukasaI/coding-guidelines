# Copy to `rustfmt.toml` at the project root.
# Per languages/rust.md's Tooling section: the Google Rust Style Guide's
# settings and nothing else. max_width = 100 is rustfmt's default, so it
# is not repeated here.

# Observed warning as nightly-only on stable rustfmt despite upstream marking
# it stable; see patterns/tooling.md "Tool status". Run `cargo fmt --check`
# once after copying; if it warns, don't add this file.
hex_literal_case = "Lower"

# Nightly-only (rustfmt "Stable: No"). Uncomment only if the project
# formats with nightly rustfmt; stable rustfmt warns on every run.
# format_macro_matchers = true
# imports_granularity = "Module"

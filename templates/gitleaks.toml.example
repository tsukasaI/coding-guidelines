# Copy to `.gitleaks.toml` at the project root.
# Per patterns/tooling.md: gitleaks is mandatory. Invoke as
# `gitleaks git --staged --redact` in the pre-commit hook — NOT
# `gitleaks detect`/`gitleaks protect`, deprecated since v8.19.0.

[extend]
# Keep the built-in rule set (AWS keys, GitHub tokens, private keys, etc.)
# and add to it below, rather than replacing it.
useDefault = true

# Placeholder custom rule: uncomment and adapt, or delete. Left active it
# would add a fake rule to every project that copies this file.
#
# [[rules]]
# id = "internal-api-token"
# description = "Internal API token"
# regex = '''internal_api_token_[a-zA-Z0-9]{32}'''
# tags = ["key", "internal"]

# Test paths are scanned like any other path (patterns/tooling.md "Secret
# scanning"): no `paths` entries for tests or testdata. Allowlist a specific
# known dummy value instead, and NEVER a real leaked credential (rotate it).
# Uncomment and adapt; each entry matches one exact fixture value.
#
# `[allowlist]` was replaced by `[[allowlists]]` in gitleaks v8.25.0
# (https://github.com/gitleaks/gitleaks#configuration).
#
# [[allowlists]]
# description = "Known dummy values used in fixtures"
# regexes = [
#   '''AKIAIOSFODNN7EXAMPLE''',   # AWS's documented example key id
# ]
# stopwords = [
#   "internal_api_token_00000000000000000000000000000000",
# ]

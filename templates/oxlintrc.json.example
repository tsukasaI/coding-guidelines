// Copy to `.oxlintrc.json` at the project root.
// This file is JSONC (comments allowed) despite the `.json` name — do NOT
// validate it with `jq` (strict JSON only); use `oxlint` itself.
// oxlint's config schema, oxfmt, and the type-aware lint path (tsgolint)
// are all still maturing (patterns/tooling.md "Tool status") — re-check
// this file against oxc.rs on version bumps.
// Base for every TypeScript project. React projects use
// templates/oxlintrc.react.json.example instead, which extends this file.
{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error",
    "style": "error"
  },
  "rules": {
    // enforced: typescript.md "any is banned in first-party code"
    "typescript/no-explicit-any": "error",
    // enforced: typescript.md "an async call MUST be awaited, returned, or
    // explicitly discarded" — type-aware, runs through tsgolint
    "typescript/no-floating-promises": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/consistent-type-imports": "error",
    // `${exhaustive}` on a `never` value is the guide's exhaustiveness idiom
    // (languages/typescript.md); the default rejects it, so allow `never`.
    "typescript/restrict-template-expressions": ["error", { "allowNever": true }],

    // Rules the enabled categories would turn on that reject code the guides
    // present as Good. Each is off individually; the categories stay at error.
    // Re-check this list on oxlint upgrades.
    // Would reject `function` declarations (typescript.md uses them).
    "eslint/func-style": "off",
    // Would reject short names like `p`, `s`, `z` in the guide's examples.
    "eslint/id-length": "off",
    // Would reject literals such as `return 30` in the guide's examples.
    "eslint/no-magic-numbers": "off",
    // Would reject the guide's deliberate key order (e.g. `{ repo, clock }`).
    "eslint/sort-keys": "off",
    // Would reject lowercase comments such as `// compile error ...`.
    "eslint/capitalized-comments": "off",
    // Would reject the trailing comment on `const exhaustive: never = p;`.
    "eslint/no-inline-comments": "off",
    // Would reject every `?:`, including JSX conditionals.
    "eslint/no-ternary": "off",
    // Would reject `null` in state types (e.g. `User | null` in svelte.md).
    "unicorn/no-null": "off",

    // enforced: typescript.md "no barrel files that re-export the world"
    // native oxc rule, no compat-layer plugin needed. A genuine large index
    // module may need tuning via the rule's `threshold` option (default
    // 100 re-exported modules) rather than a blanket disable.
    "oxc/no-barrel-file": "error",

    // enforced, partial: typescript.md "deep imports into another
    // feature's internals are forbidden". This only catches imports that
    // cross an `internal/` directory boundary at any depth; it has no
    // notion of "feature" on its own, put non-public modules under
    // `<feature>/internal/` for this to have something to match.
    "eslint/no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["**/internal/**"],
            "message": "deep import into another feature's internals; use its public surface"
          }
        ]
      }
    ]
  },
  "env": {
    "builtin": true
  }
}

// Copy to `.oxlintrc.json` at the project root.
// This file is JSONC (comments allowed) despite the `.json` name — do NOT
// validate it with `jq` (strict JSON only); use `oxlint` itself.
// oxlint's config schema, oxfmt, and the type-aware lint path (tsgolint)
// are all still maturing through 2026 — re-check this file against
// oxc.rs on version bumps.
{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "react-perf"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error",
    "style": "error"
  },
  "rules": {
    // React 19+ automatic JSX runtime: no import needed, so this rule
    // (aimed at the classic runtime) is a false positive here.
    "react/react-in-jsx-scope": "off",

    // enforced: typescript.md "any is banned in first-party code"
    "typescript/no-explicit-any": "error",
    // enforced: typescript.md "an async call MUST be awaited, returned, or
    // explicitly discarded" — type-aware, runs through tsgolint
    "typescript/no-floating-promises": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/consistent-type-imports": "error",

    // enforced: typescript.md "no barrel files that re-export the world"
    // native oxc rule, no compat-layer plugin needed. Threshold is module
    // count (default 100); a genuine large index module may need tuning
    // via the rule's `type` option rather than a blanket disable.
    "oxc/no-barrel-file": "error",

    // enforced: typescript.md "deep imports into another feature's
    // internals are forbidden" — adjust the pattern per project layout.
    "eslint/no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["*/src/*/internal/*", "*/*/internal/*"],
            "message": "deep import into another feature's internals; use its public surface"
          }
        ]
      }
    ]
  },
  "env": {
    "builtin": true
  }
}

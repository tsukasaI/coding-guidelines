# Paste into the project's `Cargo.toml`.
# Per languages/rust.md's Tooling section: default clippy groups promoted
# to deny, plus a small cherry-picked set of pedantic/nursery/restriction
# lints, NEVER `clippy::pedantic = "warn"` or `clippy::nursery = "warn"`
# wholesale.
# Pair this with templates/clippy.toml.example so unwrap_used/expect_used/
# dbg_macro don't fire inside #[cfg(test)] code.

[lints.rust]
unsafe_code = "forbid"

[lints.clippy]
correctness = { level = "deny", priority = -1 }
suspicious = { level = "deny", priority = -1 }
complexity = { level = "deny", priority = -1 }
perf = { level = "deny", priority = -1 }
style = { level = "deny", priority = -1 }

unwrap_used = "warn"
expect_used = "warn"
missing_errors_doc = "warn"
dbg_macro = "warn"
todo = "warn"
unimplemented = "warn"

# module_name_repetitions: pedantic, catches `order::OrderService` stutter.
module_name_repetitions = "warn"
# print_stdout / print_stderr: restriction, production code should log, not print.
print_stdout = "warn"
print_stderr = "warn"
# wildcard_imports: pedantic, `use foo::*` hides where a name came from.
wildcard_imports = "warn"
# indexing_slicing: restriction, `v[i]` panics on out-of-bounds; prefer .get().
indexing_slicing = "warn"
# allow_attributes_without_reason / allow_attributes: restriction, forces
# `#[expect(lint, reason = "...")]` over a bare `#[allow(lint)]` so a stale
# suppression starts warning again once the lint stops firing. Ties to
# security.md's suppression audit-trail rule.
allow_attributes = "warn"
allow_attributes_without_reason = "warn"

# redundant_clone lives in the nursery group (unstable: known false
# positive/negative reports), cherry-picked individually per the
# no-blanket-nursery rule above, not because it's especially reliable.
redundant_clone = "warn"

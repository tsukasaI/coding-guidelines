# Paste into the project's `Cargo.toml`.
# Per languages/rust.md's Tooling section: default clippy groups promoted
# to deny, plus a small cherry-picked set of pedantic/nursery/restriction
# lints, NEVER `clippy::pedantic = "warn"` or `clippy::nursery = "warn"`
# wholesale.
# Pair this with templates/clippy.toml.example so unwrap_used/expect_used/
# dbg_macro don't fire inside #[cfg(test)] code.

[lints.rust]
unsafe_code = "forbid"
# missing_docs: every public item gets a doc comment (Google Rust Style Guide).
missing_docs = "warn"

[lints.clippy]
correctness = { level = "deny", priority = -1 }
suspicious = { level = "deny", priority = -1 }
complexity = { level = "deny", priority = -1 }
perf = { level = "deny", priority = -1 }
style = { level = "deny", priority = -1 }

unwrap_used = "warn"
expect_used = "warn"
missing_errors_doc = "warn"
dbg_macro = "warn"
todo = "warn"
unimplemented = "warn"

# module_name_repetitions: pedantic, catches `order::OrderService` stutter.
module_name_repetitions = "warn"
# print_stdout / print_stderr: restriction, library and service code should
# log, not print. A CLI binary's user-facing output goes through one output
# module with `#[expect(clippy::print_stdout, reason = "...")]` there.
print_stdout = "warn"
print_stderr = "warn"
# wildcard_imports: pedantic, `use foo::*` hides where a name came from.
wildcard_imports = "warn"
# indexing_slicing: restriction, `v[i]` panics on out-of-bounds; prefer .get().
indexing_slicing = "warn"
# allow_attributes_without_reason / allow_attributes: restriction, forces
# `#[expect(lint, reason = "...")]` over a bare `#[allow(lint)]` so a stale
# suppression starts warning again once the lint stops firing. Per
# rust.md: every suppression carries a reviewable reason.
allow_attributes = "warn"
allow_attributes_without_reason = "warn"

# redundant_clone lives in the nursery group (unstable: known false
# positive/negative reports), cherry-picked individually per the
# no-blanket-nursery rule above, not because it's especially reliable.
redundant_clone = "warn"

# Google Rust Style Guide rules (see languages/rust.md "API design",
# "Implementation", "Documentation").
# missing_panics_doc: pedantic, public fns that can panic need `# Panics`.
missing_panics_doc = "warn"
# fn_params_excessive_bools: pedantic, use an enum instead of bool flags.
fn_params_excessive_bools = "warn"
# ref_option: pedantic, take `Option<&T>` instead of `&Option<T>`.
ref_option = "warn"
# needless_for_each: pedantic, a `for` loop instead of `Iterator::for_each`.
needless_for_each = "warn"
# clone_on_ref_ptr: restriction, `Arc::clone(&x)` so shared-pointer clones
# read differently from deep copies.
clone_on_ref_ptr = "warn"
# string_add: restriction, `format!`/`push_str` instead of `String + &str`.
string_add = "warn"
# undocumented_unsafe_blocks: restriction, every `unsafe` block carries a
# `// SAFETY:` comment. Only live when unsafe_code is downgraded to deny
# under a documented exception.
undocumented_unsafe_blocks = "warn"
# exhaustive_enums / exhaustive_structs: restriction, push
# `#[non_exhaustive]` onto public types. Uncomment only in a library crate
# consumed by other teams; in an application crate they over-reach.
# exhaustive_enums = "warn"
# exhaustive_structs = "warn"
